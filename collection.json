    {
      "name": "TC11 - Validar Esquema de Error OpenAPI",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC11 - Status code is 400 Bad Request por falta de Idempotency-Key', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('TC11 - Validación de Contrato ErrorResponse', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('object');",
              "    pm.expect(jsonData).to.have.property('error').that.is.a('string');",
              "    pm.expect(jsonData).to.have.property('message').that.is.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "{{token_user1}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [{\"producto\": \"Desk\", \"cantidad\": 1, \"precioUnitario\": 100}],\n  \"direccionEnvio\": \"Casa\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/pedidos",
          "host": ["{{base_url}}"],
          "path": ["pedidos"]
        }
      }
    },
    {
      "name": "TC12 - Validación de Negocio (Cantidad y Precio Positivos)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC12 - Status code is 400 Bad Request por datos negativos', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('TC12 - Array de detalles especifica el error de validación', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.eql('Bad Request');",
              "    pm.expect(jsonData.details).to.be.an('array');",
              "    pm.expect(jsonData.details.length).to.be.at.least(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
