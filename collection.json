          {
            "key": "Authorization",
            "value": "{{token_user1}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/pedidos/ord-non-existent-99999",
          "host": ["{{base_url}}"],
          "path": ["pedidos", "ord-non-existent-99999"]
        }
      }
    },
    {
      "name": "TC08 - Paginación de Resultados",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC08 - Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('TC08 - Estructura de paginación válida', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('data');",
              "    pm.expect(jsonData).to.have.property('pagination');",
              "    pm.expect(jsonData.data.length).to.be.at.most(2);",
              "    pm.expect(jsonData.pagination.page).to.eql(1);",
              "    pm.expect(jsonData.pagination.limit).to.eql(2);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{token_user1}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/pedidos?page=1&limit=2",
          "host": ["{{base_url}}"],
          "path": ["pedidos"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "2"
            }
          ]
        }
      }
    },
    {
      "name": "TC09 - Repetición de Operación Idempotente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC09 - Status code is 201 Created o cached response', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "pm.test('TC09 - Reutiliza exacto ID de pedido sin duplicar creación', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.eql(pm.environment.get('current_order_id'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "{{token_user1}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"producto\": \"Teclado RGB\",\n      \"cantidad\": 2,\n      \"precioUnitario\": 45.00\n    }\n  ],\n  \"direccionEnvio\": \"Calle 10 #45\",\n  \"notas\": \"Urgente\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/pedidos",
          "host": ["{{base_url}}"],
          "path": ["pedidos"]
        }
      }
    },
    {
      "name": "TC10 - Validar Esquema de Éxito OpenAPI",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC10 - Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('TC10 - Validación de Contrato PaginatedOrdersResponse', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('object');",
              "    pm.expect(jsonData).to.have.property('data').that.is.an('array');",
              "    pm.expect(jsonData).to.have.property('pagination').that.is.an('object');",
              "    pm.expect(jsonData.pagination).to.have.all.keys('page', 'limit', 'total', 'totalPages');",
              "    if (jsonData.data.length > 0) {",
              "        var item = jsonData.data[0];",
              "        pm.expect(item).to.have.property('id').that.is.a('string');",
              "        pm.expect(item).to.have.property('userId').that.is.a('string');",
              "        pm.expect(item).to.have.property('items').that.is.an('array');",
              "        pm.expect(item).to.have.property('direccionEnvio').that.is.a('string');",
              "        pm.expect(item).to.have.property('total').that.is.a('number');",
              "        pm.expect(item).to.have.property('estado').that.is.a('string');",
              "        pm.expect(item).to.have.property('createdAt').that.is.a('string');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{token_user1}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/pedidos",
          "host": ["{{base_url}}"],
          "path": ["pedidos"]
        }
